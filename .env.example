# NestBackend base URL - read by nuxt.config.ts's runtimeConfig.public.apiBase.
# Used by both the browser and server-rendered fetches, so it must be reachable
# from wherever this app actually runs (see docker-compose.yml's comment on
# why "localhost" doesn't work for the containerized case).
NUXT_PUBLIC_API_BASE=http://localhost:4000/v1/api
