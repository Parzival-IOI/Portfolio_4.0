# Copy to .env (git-ignored; also read by docker compose). Both values are
# SERVER-ONLY - the browser only ever talks to this app's own /api/* routes.

# Where the Nuxt server reaches NestBackend. From inside Docker "localhost" is
# the container itself, so docker-compose.yml overrides this to host.docker.internal.
NUXT_NEST_API_URL=http://localhost:4000/v1/api

# Must equal BLOG_HMAC_SECRET in NestBackend's .env. Signs the Nuxt server's
# blog requests; never sent to the browser.
NUXT_BLOG_HMAC_SECRET=change-me-blog-hmac-secret
